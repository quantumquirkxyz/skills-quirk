{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantumquirkxyz.github.io/skills-quirk/schema/tool-risk-budget.schema.json",
  "title": "Tool Risk Debt Budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedFor", "phase", "source", "budgets", "targets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "generatedFor": { "type": "string", "const": "skills-quirk" },
    "phase": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "errors", "note"],
        "properties": {
          "phase": { "type": "string", "minLength": 1 },
          "errors": { "type": "integer", "minimum": 0 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
