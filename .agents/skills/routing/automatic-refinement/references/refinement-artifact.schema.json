{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.local/schemas/refinement-artifact-v1.json",
  "title": "RefinementArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["operationId", "parentOperationId", "status", "provenance", "invocationTrace", "skillsInvoked", "routing", "budgetSpent", "loop", "agentStatuses", "handoffs", "evidence", "decisions", "assumptions", "risks", "openQuestions", "proposedArtifacts", "verification", "limitations", "approvalStatus", "nextConsumer"],
  "properties": {
    "operationId": {"type": "string", "minLength": 1},
    "parentOperationId": {"type": ["string", "null"]},
    "status": {"enum": ["refined-awaiting-review", "refined-with-limitations", "blocked", "validation-failed", "budget-exceeded", "no-progress", "cancelled", "stale-input"]},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["inputDigest", "sourceDigests", "producer", "createdAt"],
      "properties": {
        "inputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sourceDigests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
        "producer": {"type": "string", "const": "automatic-refinement"},
        "createdAt": {"type": "string", "minLength": 1},
        "parentArtifactRef": {"type": ["string", "null"]}
      }
    },
    "invocationTrace": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["invocationId", "skill", "status", "inputDigest", "outputDigest", "routingConfidence"], "properties": {
        "invocationId": {"type": "string", "minLength": 1}, "skill": {"type": "string", "minLength": 1}, "status": {"enum": ["planned", "leased", "running", "completed", "blocked", "validation-failed", "stale-input", "outcome-unknown"]}, "inputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "outputDigest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}, "routingConfidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}
      }}
    },
    "skillsInvoked": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "routing": {"type": "object", "additionalProperties": false, "required": ["confidence", "selectedCapabilities", "unresolvedRoutes"], "properties": {"confidence": {"type": "number", "minimum": 0, "maximum": 1}, "selectedCapabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "unresolvedRoutes": {"type": "array", "items": {"type": "string"}}}},
    "budgetSpent": {"type": "object", "additionalProperties": false, "required": ["iterations", "subagents", "skillInvocations", "sources", "wallTimeMs"], "properties": {"iterations": {"type": "integer", "minimum": 0}, "subagents": {"type": "integer", "minimum": 0}, "skillInvocations": {"type": "integer", "minimum": 0}, "sources": {"type": "integer", "minimum": 0}, "wallTimeMs": {"type": "integer", "minimum": 0}, "costUsd": {"type": "number", "minimum": 0}}},
    "loop": {"type": "object", "additionalProperties": false, "required": ["loopId", "ledgerRef", "recoveryPolicy", "progressEvidence", "status"], "properties": {"loopId": {"type": "string", "minLength": 1}, "ledgerRef": {"type": "string", "minLength": 1}, "recoveryPolicy": {"type": "string", "minLength": 1}, "progressEvidence": {"type": "array", "minItems": 1}, "status": {"enum": ["completed", "limits-exceeded", "repeated-action", "ping-pong", "no-progress", "blocker-escalated"]}}},
    "agentStatuses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["agentId", "capabilities", "status"], "properties": {"agentId": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "status": {"enum": ["planned", "leased", "running", "completed", "blocked", "validation-failed", "stale-input", "outcome-unknown"]}, "reason": {"type": "string"}}}},
    "handoffs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["handoffId", "traceId", "runId", "inputDigests", "outputDigest", "signature", "status", "nextOwner"], "properties": {"handoffId": {"type": "string", "minLength": 1}, "traceId": {"type": "string", "minLength": 1}, "runId": {"type": "string", "minLength": 1}, "inputDigests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "outputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "signature": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "status": {"enum": ["succeeded", "blocked", "validation-failed", "stale-input", "outcome-unknown"]}, "nextOwner": {"type": "string", "minLength": 1}, "artifactRef": {"type": "string"}}}},
    "evidence": {"type": "array", "minItems": 1}, "decisions": {"type": "array"}, "assumptions": {"type": "array"}, "risks": {"type": "array"}, "openQuestions": {"type": "array"}, "proposedArtifacts": {"type": "array"},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "independent", "evidenceRefs"], "properties": {"status": {"enum": ["passed", "partial", "blocked", "failed"]}, "independent": {"type": "boolean"}, "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "verdict": {"type": ["object", "null"]}}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approvalStatus": {"enum": ["pending-refinement-review", "not-approved", "approved-for-local-write", "not-applicable"]},
    "nextConsumer": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "refined-awaiting-review"}}}, "then": {"properties": {"approvalStatus": {"const": "pending-refinement-review"}, "verification": {"properties": {"status": {"const": "passed"}, "independent": {"const": true}}}}}},
    {"if": {"properties": {"status": {"enum": ["blocked", "validation-failed", "budget-exceeded", "no-progress", "cancelled", "stale-input"]}}}, "then": {"properties": {"approvalStatus": {"enum": ["not-approved", "pending-refinement-review", "not-applicable"]}}}}
  ]
}
