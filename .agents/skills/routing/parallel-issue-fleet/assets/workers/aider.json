{
  "schemaVersion": "1.0",
  "name": "aider",
  "description": "Aider in non-interactive message mode.",
  "setup": [
    ["python", "-m", "pip", "install", "--user", "aider-chat"]
  ],
  "command": ["aider", "--yes", "--no-auto-commits", "--message"],
  "modelArgs": ["--model", "{{model}}"],
  "promptDelivery": "argv",
  "model": "",
  "modelEnv": "AIDER_MODEL",
  "env": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY"],
  "requiredEnv": [],
  "timeoutMs": 1800000
}
