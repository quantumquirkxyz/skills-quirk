{
  "schemaVersion": "1.0",
  "name": "opencode",
  "description": "OpenCode CLI in non-interactive mode for this repository's GitHub Actions fleet.",
  "setup": [
    ["npm", "install", "-g", "opencode-ai"]
  ],
  "command": ["opencode", "run", "--standalone", "--auto"],
  "modelArgs": ["-m", "{{model}}"],
  "promptDelivery": "argv",
  "model": "",
  "modelEnv": "OPENCODE_MODEL",
  "env": ["OPENCODE_API_KEY"],
  "requiredEnv": [],
  "timeoutMs": 1800000
}
