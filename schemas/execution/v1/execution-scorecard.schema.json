{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.dev/schemas/execution/1.0/execution-scorecard.schema.json",
  "title": "Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scorecardId", "verdict", "criteria", "evaluatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scorecardId": { "type": "string", "format": "uuid" },
    "verdict": { "enum": ["pass", "fail", "blocked", "not-run", "audit-incomplete"] },
    "criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "result", "evidenceIds"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 120 }, "result": { "enum": ["pass", "fail", "blocked", "not-run", "unknown"] }, "evidenceIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true }, "notes": { "type": "string", "maxLength": 1000 } } } },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "evaluator": { "type": "string", "maxLength": 200 },
    "limitations": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
  }
}
