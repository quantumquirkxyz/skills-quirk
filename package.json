{
  "name": "skills-quirk",
  "version": "2.2.0",
  "type": "module",
  "description": "Quirk Skills — portable, validated skills bundle for AI coding agents",
  "bin": {
    "skills-quirk": "./bin/skills-quirk.js"
  },
  "scripts": {
    "test": "node --test .agents/skills/platform/tests/*.test.mjs",
    "validate": "node .agents/skills/platform/validate-skills.mjs",
    "audit": "node .agents/skills/platform/audit-semantics.mjs",
    "score": "node .agents/skills/platform/quality-scorer.mjs",
    "security": "node .agents/skills/platform/security-scanner.mjs",
    "graph": "node .agents/skills/platform/dependency-graph.mjs",
    "test:fixtures": "node .agents/skills/platform/evaluate-fixtures.mjs",
    "evals:routing:check": "node evals/run-routing.mjs --check",
    "evals:behavioral:mock": "node evals/run-behavioral.mjs --all",
    "audit:context": "node .agents/skills/platform/context-budget-auditor.mjs",
    "audit:cost": "node .agents/skills/platform/skill-lab.mjs cost",
    "scan:skills": "node .agents/skills/platform/security-scan-skills.mjs",
    "traceability": "node .agents/skills/platform/validate-traceability.mjs",
    "mcp": "node .agents/skills/platform/mcp-server/mcp-skills-server.mjs",
    "evolve": "node .agents/skills/platform/skill-evolver.mjs",
    "audit-trail": "node .agents/skills/platform/audit-trail.mjs",
    "metrics": "node .agents/skills/platform/skill-lab.mjs metrics",
    "sync": "node scripts/sync-registry.mjs",
    "catalog": "node scripts/generate-site-data.mjs",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  },
  "keywords": [
    "skills",
    "agents",
    "claude-code",
    "codex",
    "ai",
    "coding-agent",
    "prompts",
    "workflows"
  ],
  "author": "quantumquirkxyz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantumquirkxyz/skills-quirk.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    ".agents/skills/",
    "registry.yaml",
    "schema/",
    "scripts/",
    "plugins/",
    "site/"
  ]
}
