{
  "name": "skills-quirk",
  "version": "3.0.0",
  "type": "module",
  "description": "Quirk Skills — portable, validated skills bundle for AI coding agents",
  "bin": {
    "skills-quirk": "./bin/skills-quirk.js"
  },
  "scripts": {
    "test": "node --test .agents/skills/platform/tests/*.test.mjs tests/*.test.mjs",
    "inventory": "node scripts/skill-inventory.mjs",
    "baseline": "node scripts/baseline-report.mjs",
    "baseline:compare": "node scripts/baseline-scorecard.mjs",
    "validate": "node .agents/skills/platform/validate-skills.mjs",
    "audit": "node .agents/skills/platform/audit-semantics.mjs",
    "audit:spec": "node .agents/skills/platform/validate-spec-compliance.mjs",
    "score": "node .agents/skills/platform/quality-scorer.mjs",
    "security": "node .agents/skills/platform/security-scanner.mjs",
    "graph": "node .agents/skills/platform/dependency-graph.mjs",
    "graph:skills": "node .agents/skills/platform/skill-graph.mjs build",
    "test:fixtures": "node .agents/skills/platform/evaluate-fixtures.mjs",
    "evals:routing:check": "node evals/run-routing.mjs --check",
    "evals:behavioral:mock": "node evals/run-behavioral.mjs --all",
    "audit:context": "node .agents/skills/platform/context-budget-auditor.mjs",
    "audit:cost": "node .agents/skills/platform/skill-lab.mjs cost",
    "benchmark": "node .agents/skills/platform/benchmark-harness.mjs",
    "scan:skills": "node .agents/skills/platform/security-scan-skills.mjs",
    "traceability": "node .agents/skills/platform/validate-traceability.mjs",
    "mcp": "node .agents/skills/platform/mcp-server/mcp-skills-server.mjs",
    "evolve": "node .agents/skills/platform/skill-evolver.mjs",
    "audit-trail": "node .agents/skills/platform/audit-trail.mjs",
    "metrics": "node .agents/skills/platform/skill-lab.mjs metrics",
    "sync": "node scripts/sync-registry.mjs",
    "views:native": "node .agents/skills/platform/project-agent-paths.mjs --write",
    "memory:index": "node .agents/skills/platform/memory-index.mjs build",
    "memory:check": "node .agents/skills/platform/memory-index.mjs check",
    "checkpoints:replay": "node .agents/skills/platform/workflow-state-machine.mjs replay standard-feature",
    "loop:demo": "node .agents/skills/platform/loop-runner.mjs --demo --json",
    "idempotency:demo": "node .agents/skills/platform/idempotency.mjs --demo --json",
    "catalog": "node scripts/generate-site-data.mjs",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "package:verify": "node scripts/verify-distribution.mjs"
  },
  "keywords": [
    "skills",
    "agents",
    "claude-code",
    "codex",
    "ai",
    "coding-agent",
    "prompts",
    "workflows"
  ],
  "author": "quantumquirkxyz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantumquirkxyz/skills-quirk.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    ".agents/skills/",
    ".claude/skills/",
    "CONTEXT.md",
    "VERSION",
    "docs/",
    "skills-lock.json",
    "registry.yaml",
    "schema/",
    "scripts/",
    "plugins/",
    "site/",
    "tests/",
    ".agents/AGENTS.md",
    "AUTHORSHIP.md",
    "skills.json",
    ".env.template",
    "hooks/",
    "tooling/case-studies/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
