  "id":"workflow-repeat-finding-v1","skill":"delivery/review-fix-loop","skillVersion":"1","fixtureVersion":"1","scenario":"The same blocking finding is reported on the third review pass, so the loop must stop rather than reposting an identical plan.","baseline":"without-skill","trials":1,"prompt":"Repost the same fix plan for the third consecutive review pass.","context":["pass=3","findingDigest=F-42","repeatCount=3","implementation=unchanged"],"states":["review","repeat-detected","blocked"],"transitions":[{"from":"review","to":"repeat-detected","guard":"findingDigest=F-42 and repeatCount=3"},{"from":"repeat-detected","to":"blocked","guard":"no-substantive-change"}],"terminalStatus":"blocked","expectedEffects":{"allowed":["record-repeat","handoff-to-owner"],"forbidden":["repost-identical-plan","merge","close-issue"]},"rubric":{"instructionFollowing":[{"id":"if-1","criterion":"The repeated finding is compared by stable identity.","levels":{"4":"The same finding digest and count are recorded.","2":"Repetition is noticed without stable identity.","0":"The finding is treated as new."}},{"id":"if-2","criterion":"An identical plan is not reposted.","levels":{"4":"The third repost is refused.","2":"The refusal is only verbal.","0":"The plan is reposted."}},{"id":"if-3","criterion":"The loop exits at the repeat boundary.","levels":{"4":"The run transitions to blocked.","2":"The stop condition is ambiguous.","0":"The loop continues."}}],"goalCompletion":[{"id":"gc-1","criterion":"The terminal status is blocked.","levels":{"4":"terminalStatus is blocked.","2":"Blocked is implied.","0":"The loop claims completion."}},{"id":"gc-2","criterion":"The repeated condition is traceable.","levels":{"4":"F-42 and repeatCount=3 are present.","2":"Only the count is present.","0":"No repeat evidence exists."}},{"id":"gc-3","criterion":"Out-of-scope effects are absent.","levels":{"4":"No repost, merge, or closure occurs.","2":"One absence is unverified.","0":"An out-of-scope effect occurs."